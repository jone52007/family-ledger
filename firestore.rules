rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 只允許家華與太太的 Google 帳號讀寫（email 請改成你們的）
    function isFamily() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in ['jone1525@gmail.com', 'weiwei91005@gmail.com'];
    }
    match /households/main/{document=**} {
      allow read, write: if isFamily();
    }
  }
}
